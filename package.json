{
  "name": "frankfurt-life",
  "version": "0.5.1",
  "description": "Frankfurt Life - Desktop launcher and Electron game",
  "main": "electron/main.cjs",
  "author": "Frankfurt Life Community",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:legacy": "electron-builder --config electron-builder-legacy.yml --win nsis portable --publish never",
    "dist:classic": "electron-builder --config electron-builder-classic.yml --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.frankfurtlife.game",
    "productName": "Frankfurt Life",
    "directories": {
      "output": "dist"
    },
    "files": [
      "game.html",
      "game.css",
      "index.html",
      "style.css",
      "script.js",
      "electron/**/*",
      "assets/**/*",
      "launcher.html",
      "launcher.css",
      "launcher.js",
      "node_modules/three/**/*",
      "studio.html",
      "studio.css",
      "studio.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "three": "^0.160.0"
  }
}
