{
  "name": "frankfurt-life",
  "version": "0.1.2",
  "description": "Frankfurt Life - 3D city exploration prototype",
  "main": "electron/main.cjs",
  "author": "F3L1X",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "41.7.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.frankfurtlife.game",
    "productName": "Frankfurt Life",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
